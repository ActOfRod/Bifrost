+    public synchronized void onControlsProfileChanged(ControlsProfile profile) {
+        if (stickyVirtualProfile != null && stickyVirtualProfile != profile &&
+            resetGamepadState(stickyVirtualProfile)) {
+            sendGamepadState(stickyVirtualProfile);
+        }
+
+        if (profile != null && profile.isVirtualGamepad()) stickyVirtualProfile = profile;
+        String message;
+        if (profile == null) {
+            message = "PROFILE_CHANGE none disableMouseInput=false";
+        }
+        else {
+            String name = String.valueOf(profile.getName())
+                .replace("\\", "\\\\").replace("\"", "\\\"").replace('\n', ' ');
+            message = "PROFILE_CHANGE id=" + profile.id + " name=\"" + name +
+                "\" isVirtualGamepad=" + profile.isVirtualGamepad() +
+                " disableMouseInput=" + profile.isDisableMouseInput();
+        }
+        Log.i("BifrostGamepad", message);
+        appendDiagnosticLog(message);
+    }
+
+    private boolean resetGamepadState(ControlsProfile profile) {
+        GamepadState state = profile.getGamepadState();
+        boolean changed = state.buttons != 0 || state.thumbLX != 0 || state.thumbLY != 0 ||
+            state.thumbRX != 0 || state.thumbRY != 0 || state.triggerL != 0 || state.triggerR != 0;
+        for (boolean pressed : state.dpad) changed |= pressed;
+        state.buttons = 0;
+        state.thumbLX = 0;
+        state.thumbLY = 0;
+        state.thumbRX = 0;
+        state.thumbRY = 0;
+        state.triggerL = 0;
+        state.triggerR = 0;
+        Arrays.fill(state.dpad, false);
+        return changed;
+    }
