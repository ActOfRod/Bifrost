+    @Override
+    public boolean isAxisMapped(int deviceId, int axis, float value) {
+        if (editMode || Math.abs(value) <= ControlElement.STICK_DEAD_ZONE) return false;
+        ExternalController controller = profile != null ? profile.getController(deviceId) : null;
+        byte direction = (byte)Math.signum(value);
+        return controller != null && hasControllerBinding(controller, ExternalControllerBinding.getKeyCodeForAxis(axis, direction));
+    }
+
+    @Override
+    public boolean isTriggerMapped(int deviceId, boolean left) {
+        ExternalController controller = profile != null ? profile.getController(deviceId) : null;
+        return !editMode && controller != null && hasControllerBinding(controller, left ? KeyEvent.KEYCODE_BUTTON_L2 : KeyEvent.KEYCODE_BUTTON_R2);
+    }
