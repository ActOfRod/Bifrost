+        if (!bifrostDir.isDirectory() && !bifrostDir.mkdirs() && !bifrostDir.isDirectory()) return false;
+
+        File readyFile = new File(bifrostDir, "gamepad-ready");
+        boolean readyFileCleared = deleteIfExists(readyFile);
+        boolean launchLogCleared = deleteIfExists(new File(bifrostDir, "launch.log"));
+        winHandler.gamepadHandler.setGamepadReadyFile(readyFile);
+        return readyFileCleared && launchLogCleared && installGuestLaunchHelper(windowsDir);
+    }
