+package com.winlator.core;
+
+import java.util.Locale;
+
+public final class GuestLaunchCommand {
+    private GuestLaunchCommand() {}
+
+    public static String build(String execDir, String filename, String execArgs, boolean useHelper) {
+        boolean wrapWithHelper = useHelper && filename.toLowerCase(Locale.ENGLISH).endsWith(".exe");
+        String executable = wrapWithHelper
+            ? "\"C:\\windows\\bifrost-launch.exe\" \"" + filename + "\""
+            : "\"" + filename + "\"";
+        return "/dir " + StringUtils.escapeDOSPath(execDir) + " " + executable +
+            (execArgs == null ? "" : execArgs);
+    }
+}
