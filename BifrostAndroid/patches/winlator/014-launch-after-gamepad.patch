+    private static int readChunk(InputStream input, byte[] buffer) throws IOException {
+        int offset = 0;
+        while (offset < buffer.length) {
+            int bytesRead = input.read(buffer, offset, buffer.length - offset);
+            if (bytesRead < 0) break;
+            if (bytesRead == 0) {
+                int nextByte = input.read();
+                if (nextByte < 0) break;
+                buffer[offset++] = (byte)nextByte;
+            }
+            else offset += bytesRead;
+        }
+        return offset == 0 ? -1 : offset;
+    }
+
+    private boolean assetMatchesFile(File file, String assetName) throws IOException {
+        if (!file.isFile()) return false;
+        try (InputStream asset = getAssets().open(assetName);
+             FileInputStream installed = new FileInputStream(file)) {
+            byte[] assetBuffer = new byte[8192];
+            byte[] installedBuffer = new byte[8192];
+            while (true) {
+                int assetBytes = readChunk(asset, assetBuffer);
+                int installedBytes = readChunk(installed, installedBuffer);
+                if (assetBytes != installedBytes) return false;
+                if (assetBytes == -1) return true;
+                for (int i = 0; i < assetBytes; i++) {
+                    if (assetBuffer[i] != installedBuffer[i]) return false;
+                }
+            }
+        }
+    }
+
+    private boolean installGuestLaunchHelper(File windowsDir) {
+        File helperFile = new File(windowsDir, "bifrost-launch.exe");
+        File tempFile = new File(windowsDir, "bifrost-launch.exe.tmp");
+        try {
+            if (assetMatchesFile(helperFile, "bifrost-launch.exe")) return true;
+            try (InputStream input = getAssets().open("bifrost-launch.exe");
+                 FileOutputStream output = new FileOutputStream(tempFile, false)) {
+                byte[] buffer = new byte[8192];
+                int bytesRead;
+                while ((bytesRead = input.read(buffer)) != -1) output.write(buffer, 0, bytesRead);
+                output.getFD().sync();
+            }
+            Files.move(tempFile.toPath(), helperFile.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            return helperFile.isFile() && helperFile.length() > 0;
+        }
+        catch (Exception e) {
+            tempFile.delete();
+            Log.e("BifrostLaunch", "Unable to install guest launch helper", e);
+            return false;
+        }
+    }
+
+    private static boolean deleteIfExists(File file) {
+        return !file.exists() || file.delete();
+    }
+
+    private boolean prepareGuestLaunchFiles() {
