+    private void startWineInputTrace(File externalFilesDir, String executableName) {
+        File logsDirectory = new File(externalFilesDir, "logs");
+        if (!logsDirectory.isDirectory() && !logsDirectory.mkdirs() && !logsDirectory.isDirectory()) return;
+        synchronized (wineInputTraceLock) {
+            wineInputTraceLineCount = 0;
+            wineInputTraceCapped = false;
+            wineInputTraceFinished = false;
+            try {
+                wineInputTraceWriter = new BufferedWriter(new OutputStreamWriter(
+                    new FileOutputStream(new File(logsDirectory, "wine-input.log"), false),
+                    StandardCharsets.UTF_8));
+                wineInputTraceWriter.write("TRACE_START timestamp=" + System.currentTimeMillis() +
+                    " exe=\"" + executableName + "\"");
+                wineInputTraceWriter.newLine();
+                wineInputTraceWriter.flush();
+            }
+            catch (IOException ignored) {
+                wineInputTraceWriter = null;
+                return;
+            }
+        }
+        wineInputTraceCallback = line -> appendWineInputTrace(line);
+        ProcessHelper.addDebugCallback(wineInputTraceCallback);
+    }
+
+    private void appendWineInputTrace(String line) {
+        if (!ControllerTrace.shouldLogLine(line)) return;
+        synchronized (wineInputTraceLock) {
+            if (wineInputTraceWriter == null || wineInputTraceFinished || wineInputTraceCapped) return;
+            try {
+                if (wineInputTraceLineCount >= 20000) {
+                    wineInputTraceWriter.write("TRACE_CAPPED");
+                    wineInputTraceWriter.newLine();
+                    wineInputTraceWriter.flush();
+                    wineInputTraceCapped = true;
+                    return;
+                }
+                wineInputTraceWriter.write(line);
+                wineInputTraceWriter.newLine();
+                wineInputTraceLineCount++;
+                if (wineInputTraceLineCount == 20000) {
+                    wineInputTraceWriter.write("TRACE_CAPPED");
+                    wineInputTraceWriter.newLine();
+                    wineInputTraceWriter.flush();
+                    wineInputTraceCapped = true;
+                }
+            }
+            catch (IOException ignored) {
+                wineInputTraceFinished = true;
+            }
+        }
+    }
+
+    private void finishWineInputTrace() {
+        synchronized (wineInputTraceLock) {
+            wineInputTraceFinished = true;
+            if (wineInputTraceWriter == null) return;
+            try {
+                wineInputTraceWriter.flush();
+            }
+            catch (IOException ignored) {}
+        }
+    }
+
+    private void closeWineInputTrace() {
+        Callback<String> callback = wineInputTraceCallback;
+        wineInputTraceCallback = null;
+        if (callback != null) ProcessHelper.removeDebugCallback(callback);
+        synchronized (wineInputTraceLock) {
+            wineInputTraceFinished = true;
+            if (wineInputTraceWriter == null) return;
+            try {
+                wineInputTraceWriter.flush();
+                wineInputTraceWriter.close();
+            }
+            catch (IOException ignored) {}
+            wineInputTraceWriter = null;
+        }
