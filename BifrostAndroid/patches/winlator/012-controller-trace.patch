@@ -0,0 +1,25 @@
+package com.winlator.core;
+
+import java.util.Locale;
+
+public final class ControllerTrace {
+    private static final String WINE_DEBUG_CHANNELS = "+dinput,+hid,+xinput";
+
+    private ControllerTrace() {}
+
+    public static String composeWineDebug(String current) {
+        String value = current == null ? "" : current.trim();
+        if (value.isEmpty() || "-all".equals(value)) return WINE_DEBUG_CHANNELS;
+        return value + (value.endsWith(",") ? "" : ",") + WINE_DEBUG_CHANNELS;
+    }
+
+    public static boolean shouldLogLine(String line) {
+        if (line == null) return false;
+        String lowerCaseLine = line.toLowerCase(Locale.ROOT);
+        return lowerCaseLine.contains("dinput") ||
+            lowerCaseLine.contains("hid") ||
+            lowerCaseLine.contains("xinput") ||
+            lowerCaseLine.contains("err:") ||
+            lowerCaseLine.contains("fixme:");
+    }
+}
