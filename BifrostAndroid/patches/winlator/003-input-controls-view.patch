+    private boolean isControllerConnected() {
+        for (int deviceId : InputDevice.getDeviceIds()) {
+            InputDevice device = InputDevice.getDevice(deviceId);
+            if (device == null) continue;
+            int sources = device.getSources();
+            if ((sources & InputDevice.SOURCE_GAMEPAD) == InputDevice.SOURCE_GAMEPAD ||
+                (sources & InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK) return true;
+        }
+        return false;
+    }
+
+    private boolean shouldHideControls() {
+        return !editMode && profile != null && profile.isAutoHideWithController() && isControllerConnected();
+    }
+
+    private void vibrateForPress() {
+        if (editMode || profile == null || !profile.isHapticsEnabled()) return;
+        Vibrator vibrator = (Vibrator)getContext().getSystemService(Context.VIBRATOR_SERVICE);
+        if (vibrator == null || !vibrator.hasVibrator()) return;
+        int strength = profile.getHapticStrength();
+        long duration = 10L + (30L * (strength - 1) / 99);
+        int amplitude = Math.max(1, Math.min(255, strength * 255 / 100));
+        if (Build.VERSION.SDK_INT >= 26) vibrator.vibrate(VibrationEffect.createOneShot(duration, amplitude));
+    }
