@@ -0,0 +1,26 @@
+package com.winlator.winhandler;
+
+import java.util.ArrayDeque;
+
+public final class GatedActionQueue {
+    private final ArrayDeque<Runnable> gatedActions = new ArrayDeque<>();
+    private final ArrayDeque<Runnable> ungatedActions = new ArrayDeque<>();
+
+    public void add(Runnable action) {
+        gatedActions.add(action);
+    }
+
+    public void addUngated(Runnable action) {
+        ungatedActions.add(action);
+    }
+
+    public Runnable poll(boolean initReceived) {
+        Runnable action = ungatedActions.poll();
+        if (action != null) return action;
+        return initReceived ? gatedActions.poll() : null;
+    }
+
+    public boolean isEmpty() {
+        return gatedActions.isEmpty() && ungatedActions.isEmpty();
+    }
+}
