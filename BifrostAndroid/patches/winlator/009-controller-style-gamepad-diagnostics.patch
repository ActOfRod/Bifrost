+    private void drawDpadChevron(Canvas canvas, Paint paint, float cx, float cy, int direction, boolean pressed, float size) {
+        float half = size * 0.11f;
+        Path path = new Path();
+        if (direction == 0) {
+            path.moveTo(cx - half, cy + half * 0.5f);
+            path.lineTo(cx, cy - half * 0.5f);
+            path.lineTo(cx + half, cy + half * 0.5f);
+        }
+        else if (direction == 1) {
+            path.moveTo(cx - half * 0.5f, cy - half);
+            path.lineTo(cx + half * 0.5f, cy);
+            path.lineTo(cx - half * 0.5f, cy + half);
+        }
+        else if (direction == 2) {
+            path.moveTo(cx - half, cy - half * 0.5f);
+            path.lineTo(cx, cy + half * 0.5f);
+            path.lineTo(cx + half, cy - half * 0.5f);
+        }
+        else {
+            path.moveTo(cx + half * 0.5f, cy - half);
+            path.lineTo(cx - half * 0.5f, cy);
+            path.lineTo(cx + half * 0.5f, cy + half);
+        }
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(size * 0.05f);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeJoin(Paint.Join.ROUND);
+        paint.setColor(withDrawOpacity(pressed ? 0xFF18212B : 0xB3FFFFFF));
+        canvas.drawPath(path, paint);
+    }
