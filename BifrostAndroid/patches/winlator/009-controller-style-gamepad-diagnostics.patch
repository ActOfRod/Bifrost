+    private void drawDpadArm(Canvas canvas, Paint paint, RectF arm, int direction, boolean pressed, float size) {
+        float radius = arm.width() < arm.height() ? arm.width() * 0.34f : arm.height() * 0.34f;
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(withDrawOpacity(pressed ? 0xE6FFFFFF : 0x73000000));
+        canvas.drawRoundRect(arm, radius, radius, paint);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(size * 0.035f);
+        paint.setColor(withDrawOpacity(0xB3FFFFFF));
+        canvas.drawRoundRect(arm, radius, radius, paint);
+
+        float cx = arm.centerX();
+        float cy = arm.centerY();
+        drawDpadChevron(canvas, paint, cx, cy, direction, pressed, size);
+    }
