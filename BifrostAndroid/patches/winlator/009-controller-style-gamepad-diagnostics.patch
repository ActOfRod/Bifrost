+    private void drawButtonShape(Canvas canvas, Paint paint, Rect box, int snappingSize) {
+        float radius = box.height() * 0.5f;
+        switch (shape) {
+            case CIRCLE:
+                canvas.drawCircle(box.centerX(), box.centerY(), box.width() * 0.5f, paint);
+                break;
+            case RECT:
+                canvas.drawRect(box, paint);
+                break;
+            case ROUND_RECT:
+                canvas.drawRoundRect(box.left, box.top, box.right, box.bottom, radius, radius, paint);
+                break;
+            case SQUARE:
+                radius = snappingSize * 0.75f * scale;
+                canvas.drawRoundRect(box.left, box.top, box.right, box.bottom, radius, radius, paint);
+                break;
+        }
+    }
