+    private void drawPlaystationSymbol(Canvas canvas, Paint paint, int symbol, float cx, float cy, float size, int color) {
+        paint.setColor(withDrawOpacity(color));
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(size * 0.12f);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeJoin(Paint.Join.ROUND);
+        float half = size * 0.28f;
+        if (symbol == 1) {
+            canvas.drawLine(cx - half, cy - half, cx + half, cy + half, paint);
+            canvas.drawLine(cx + half, cy - half, cx - half, cy + half, paint);
+        }
+        else if (symbol == 2) {
+            canvas.drawCircle(cx, cy, half, paint);
+        }
+        else if (symbol == 3) {
+            canvas.drawRect(cx - half, cy - half, cx + half, cy + half, paint);
+        }
+        else if (symbol == 4) {
+            Path triangle = new Path();
+            triangle.moveTo(cx, cy - half);
+            triangle.lineTo(cx + half, cy + half);
+            triangle.lineTo(cx - half, cy + half);
+            triangle.close();
+            canvas.drawPath(triangle, paint);
+        }
+    }
+
+    private void drawControllerButton(Canvas canvas, int snappingSize) {
+        Paint paint = inputControlsView.getPaint();
+        Rect box = getBoundingBox();
+        float cx = box.centerX();
+        float cy = box.centerY();
+        boolean pressed = propertyFlags.isSet(FLAG_PRESSED);
+        Binding styledBinding = getStyledButtonBinding();
+        int accent = styledBinding != null ? getFaceButtonAccent(styledBinding) : 0;
+        int symbol = styledBinding != null && "playstation".equals(inputControlsView.getControllerStyle()) ?
+            getPlaystationSymbol(styledBinding) : 0;
+        boolean hasStyledLabel = styledBinding != null && getStyledButtonLabel(styledBinding) != null;
+        String label = hasStyledLabel ? getStyledButtonLabel(styledBinding) : getDisplayText();
+        if (iconId > 0) label = "";
+
+        int saveCount = canvas.save();
+        if (pressed) canvas.scale(0.94f, 0.94f, cx, cy);
+
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(withDrawOpacity(pressed ? (accent != 0 ? accent : 0xE6FFFFFF) : 0x73000000));
+        drawButtonShape(canvas, paint, box, snappingSize);
+
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(snappingSize * 0.18f);
+        paint.setColor(withDrawOpacity(0xB3FFFFFF));
+        drawButtonShape(canvas, paint, box, snappingSize);
+
+        if (propertyFlags.isSet(FLAG_SELECTED)) {
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(snappingSize * 0.4f);
+            paint.setColor(getHighlightColor());
+            drawButtonShape(canvas, paint, box, snappingSize);
+        }
+
+        if (iconId > 0) {
+            drawIcon(canvas, cx, cy, box.width(), box.height(), iconId, true);
+        }
+        else if (symbol != 0) {
+            int symbolColor = pressed ? 0xFF18212B : accent;
+            drawPlaystationSymbol(canvas, paint, symbol, cx, cy, Math.min(box.width(), box.height()), symbolColor);
+        }
+        else if (!label.isEmpty()) {
+            paint.setStyle(Paint.Style.FILL);
+            paint.setTextAlign(Paint.Align.CENTER);
+            paint.setTextSize(Math.min(
+                getTextSizeForWidth(paint, label, box.width() - snappingSize * 0.36f),
+                snappingSize * 2 * scale));
+            int textColor = pressed ? 0xFF18212B : (accent != 0 ? accent : 0xFFFFFFFF);
+            paint.setColor(withDrawOpacity(textColor));
+            canvas.drawText(label, cx, cy - ((paint.descent() + paint.ascent()) * 0.5f), paint);
+        }
+        canvas.restoreToCount(saveCount);
+    }
