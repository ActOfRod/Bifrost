+    public synchronized Diagnostics getDiagnostics() {
+        return new Diagnostics(getGamepadRequestCount, lastGetGamepadHadConnectedSlot,
+            gamepadStatePacketsSent, setGamepadStateRequestCount);
+    }
+
+    public void startDiagnosticsLog(File file, String sessionHeader) {
+        diagnosticLogFile = file;
+        synchronized (this) {
+            getGamepadRequestCount = 0;
+            lastGetGamepadHadConnectedSlot = false;
+            gamepadStatePacketsSent = 0;
+            setGamepadStateRequestCount = 0;
+            sessionEndLogged = false;
+        }
+        Log.i("BifrostGamepad", sessionHeader);
+        writeDiagnosticLog(file, sessionHeader, false);
+    }
+
+    public void finishDiagnosticsLog() {
+        synchronized (this) {
+            if (sessionEndLogged) return;
+            sessionEndLogged = true;
+        }
+        String message = "SESSION_END " + diagnosticsSummary(getDiagnostics());
+        Log.i("BifrostGamepad", message);
+        appendDiagnosticLog(message);
+    }
+
+    private static String diagnosticsSummary(Diagnostics diagnostics) {
+        return "getGamepadRequests=" + diagnostics.getGamepadRequestCount +
+            " lastGetGamepadHadConnectedSlot=" + diagnostics.lastGetGamepadHadConnectedSlot +
+            " getGamepadStatePacketsSent=" + diagnostics.gamepadStatePacketsSent +
+            " setGamepadStateRequests=" + diagnostics.setGamepadStateRequestCount;
+    }
+
+    private void appendDiagnosticLog(String line) {
+        File file = diagnosticLogFile;
+        if (file != null) writeDiagnosticLog(file, line, true);
+    }
+
+    private static void writeDiagnosticLog(File file, String line, boolean append) {
+        if (file == null) return;
+        try {
+            diagnosticLogWriter.execute(() -> {
+                try {
+                    File parent = file.getParentFile();
+                    if (parent != null && !parent.isDirectory() && !parent.mkdirs() && !parent.isDirectory()) return;
+                    try (FileOutputStream outputStream = new FileOutputStream(file, append)) {
+                        outputStream.write((line + System.lineSeparator()).getBytes(StandardCharsets.UTF_8));
+                    }
+                }
+                catch (Exception ignored) {}
+            });
+        }
+        catch (Exception ignored) {}
+    }
